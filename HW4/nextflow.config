// ============================================================
//  nextflow.config — Genomics Variant-Calling Pipeline
//  Profiles: local | cluster | container | container_singularity | stub
// ============================================================

params {
    // --- Multi-sample input ---
    samplesheet         = ''           // CSV with sample_id,group,type,sra_id,ref_id

    // --- Legacy single-sample input ---
    sra_id              = ''
    sample_id           = ''
    sample_type         = 'sample'
    input_reads_folder  = ''

    // --- Reference selection ---
    reference           = ''           // Path to one shared reference FASTA
    ref_id              = ''           // Shared accession fallback for legacy modes
    assembly            = false        // Assemble one reference per sample from reads

    // --- Output ---
    outdir              = './results'

    // --- Resource defaults ---
    threads             = 2

    // --- QC & trimming ---
    min_quality         = 15
    min_read_length     = 30

    // --- Variant filtering ---
    filter_variants     = true
    min_variant_qual    = 20
    min_depth           = 5

    // --- Group comparison ---
    enable_group_comparison = false
    comparison_a_type   = 'sample_a'
    comparison_b_type   = 'sample_b'

    // --- Local profile ---
    conda_env_path      = ''
}

profiles {
    local {
        conda.enabled   = true
        conda.useMamba  = false

        process {
            executor    = 'local'
            conda       = params.conda_env_path

            cpus        = 4
            memory      = '16 GB'
            time        = '4 h'

            withName: download_sra {
                cpus    = 2
                memory  = '4 GB'
                time    = '30 min'
            }
            withName: run_qc {
                cpus    = 2
                memory  = '2 GB'
            }
            withName: trim_reads {
                cpus    = 2
                memory  = '2 GB'
            }
            withName: assemble_reads {
                cpus    = 4
                memory  = '16 GB'
                time    = '2 h'
            }
            withName: fetch_reference {
                cpus    = 1
                memory  = '1 GB'
                time    = '15 min'
            }
            withName: map_reads {
                cpus    = 4
                memory  = '8 GB'
            }
            withName: plot_coverage {
                cpus    = 1
                memory  = '4 GB'
            }
            withName: call_variants {
                cpus    = 4
                memory  = '8 GB'
            }
            withName: filter_variants {
                cpus    = 1
                memory  = '2 GB'
            }
            withName: compare_group_variants {
                cpus    = 1
                memory  = '2 GB'
            }
        }
    }

    cluster {
        conda.enabled   = true
        conda.useMamba  = true

        process {
            executor        = 'slurm'
            conda           = "${projectDir}/envs/environment.yml"
            queue           = 'normal'
            clusterOptions  = '--account=myproject'

            cpus            = 8
            memory          = '32 GB'
            time            = '8 h'
            errorStrategy   = 'retry'
            maxRetries      = 3

            withName: download_sra {
                cpus        = 2
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: run_qc {
                cpus        = 4
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: trim_reads {
                cpus        = 4
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: assemble_reads {
                cpus        = 16
                memory      = '64 GB'
                time        = '24 h'
                queue       = 'long'
            }
            withName: fetch_reference {
                cpus        = 1
                memory      = '2 GB'
                time        = '30 min'
                queue       = 'short'
            }
            withName: map_reads {
                cpus        = 8
                memory      = '32 GB'
                time        = '4 h'
            }
            withName: plot_coverage {
                cpus        = 2
                memory      = '8 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: call_variants {
                cpus        = 8
                memory      = '16 GB'
                time        = '4 h'
            }
            withName: filter_variants {
                cpus        = 2
                memory      = '4 GB'
                time        = '30 min'
                queue       = 'short'
            }
            withName: compare_group_variants {
                cpus        = 2
                memory      = '4 GB'
                time        = '30 min'
                queue       = 'short'
            }
        }
    }

    container {
        docker.enabled      = true
        singularity.enabled = false
        docker.runOptions   = '--platform linux/amd64'

        process {
            executor = 'local'

            cpus    = 4
            memory  = '16 GB'
            time    = '4 h'

            withName: download_sra {
                container   = 'ghcr.io/ncbi/sra-tools:3.0.7'
                cpus        = 2
                memory      = '4 GB'
                time        = '30 min'
            }
            withName: run_qc {
                container   = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: trim_reads {
                container   = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: assemble_reads {
                container   = 'quay.io/biocontainers/spades:3.15.5--h95f258a_1'
                cpus        = 4
                memory      = '16 GB'
                time        = '2 h'
            }
            withName: fetch_reference {
                container   = 'quay.io/biocontainers/entrez-direct:16.2--he881be0_1'
                cpus        = 1
                memory      = '1 GB'
            }
            withName: map_reads {
                container   = 'docker.io/youruser/bwa-samtools:1.0.0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: plot_coverage {
                container   = 'docker.io/youruser/r-ggplot2:1.0.0'
                cpus        = 1
                memory      = '4 GB'
            }
            withName: call_variants {
                container   = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: filter_variants {
                container   = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
            withName: compare_group_variants {
                container   = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
        }
    }

    container_singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            executor            = 'slurm'
            clusterOptions      = '--account=myproject'

            cpus    = 4
            memory  = '16 GB'
            time    = '4 h'

            withName: download_sra {
                container   = 'https://depot.galaxyproject.org/singularity/sra-tools:3.0.7--h9f5acd7_0'
                cpus        = 2
                memory      = '4 GB'
            }
            withName: run_qc {
                container   = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: trim_reads {
                container   = 'https://depot.galaxyproject.org/singularity/fastp:0.23.4--h5f740d0_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: assemble_reads {
                container   = 'https://depot.galaxyproject.org/singularity/spades:3.15.5--h95f258a_1'
                cpus        = 4
                memory      = '16 GB'
                time        = '2 h'
            }
            withName: fetch_reference {
                container   = 'https://depot.galaxyproject.org/singularity/entrez-direct:16.2--he881be0_1'
                cpus        = 1
                memory      = '1 GB'
            }
            withName: map_reads {
                container   = 'docker://youruser/bwa-samtools:1.0.0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: plot_coverage {
                container   = 'docker://youruser/r-ggplot2:1.0.0'
                cpus        = 1
                memory      = '4 GB'
            }
            withName: call_variants {
                container   = 'https://depot.galaxyproject.org/singularity/bcftools:1.18--h8b25389_0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: filter_variants {
                container   = 'https://depot.galaxyproject.org/singularity/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
            withName: compare_group_variants {
                container   = 'https://depot.galaxyproject.org/singularity/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
        }
    }

    stub {
        process {
            executor = 'local'
            cpus     = 1
            memory   = '1 GB'
            time     = '30 min'
        }

        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
}
