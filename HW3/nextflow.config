// ============================================================
//  nextflow.config — Genomics Variant-Calling Pipeline
//  Profiles: local | cluster | container
// ============================================================

// ------------------------------------------------------------
// GLOBAL PARAMETERS
// All required and optional pipeline inputs
// ------------------------------------------------------------
params {

    // --- Input (one of the following is required) ---
    sra_id              = ''           // SRA accession, e.g. 'SRR33727007'
    input_reads_folder  = ''           // Path to folder containing *.fastq files

    // --- Reference (one of the following is required) ---
    reference           = ''           // Path to reference FASTA
    assembly            = false        // Assemble reference de-novo from reads

    // --- Output ---
    outdir              = './results'  // Output directory

    // --- Resource defaults (overridden per profile) ---
    threads             = 2

    // --- QC & trimming (optional) ---
    min_quality         = 15          // fastp minimum base quality
    min_read_length     = 30          // fastp minimum read length

    // --- Variant calling (optional) ---
    filter_variants     = true        // Run variant filtering step
    min_variant_qual    = 20          // bcftools QUAL threshold
    min_depth           = 5           // Minimum read depth for variant

    // --- Local profile: path to existing conda environment ---
    conda_env_path      = ''          // e.g. '/home/user/miniconda3/envs/bioenv'
}

// ------------------------------------------------------------
// PROFILES
// ------------------------------------------------------------
profiles {

    // ----------------------------------------------------------
    // local — run on the current workstation
    // Uses a pre-existing conda environment (conda_env_path param)
    // ----------------------------------------------------------
    local {
        conda.enabled   = true
        conda.useMamba  = false

        process {
            executor    = 'local'
            conda       = params.conda_env_path   // path to local env

            cpus        = 4
            memory      = '16 GB'
            time        = '4 h'

            withName: download_sra {
                cpus    = 2
                memory  = '4 GB'
                time    = '30 min'
            }
            withName: run_qc {
                cpus    = 2
                memory  = '2 GB'
            }
            withName: trim_reads {
                cpus    = 2
                memory  = '2 GB'
            }
            withName: assemble_reads {
                cpus    = 4
                memory  = '16 GB'
                time    = '2 h'
            }
            withName: map_reads {
                cpus    = 4
                memory  = '8 GB'
            }
            withName: plot_coverage {
                cpus    = 1
                memory  = '4 GB'
            }
            withName: call_variants {
                cpus    = 4
                memory  = '8 GB'
            }
            withName: filter_variants {
                cpus    = 1
                memory  = '2 GB'
            }
        }
    }

    // ----------------------------------------------------------
    // cluster — SLURM/HPC execution
    // Dependencies managed via a conda environment.yml
    // ----------------------------------------------------------
    cluster {
        conda.enabled   = true
        conda.useMamba  = true        // mamba is typically available on clusters

        process {
            executor        = 'slurm'
            // Conda env is built from the bundled environment.yml
            conda           = "${projectDir}/envs/environment.yml"
            queue           = 'normal'
            clusterOptions  = '--account=myproject'  // adjust to your HPC account

            cpus            = 8
            memory          = '32 GB'
            time            = '8 h'

            errorStrategy   = 'retry'
            maxRetries      = 3

            withName: download_sra {
                cpus        = 2
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: run_qc {
                cpus        = 4
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: trim_reads {
                cpus        = 4
                memory      = '4 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: assemble_reads {
                cpus        = 16
                memory      = '64 GB'
                time        = '24 h'
                queue       = 'long'
            }
            withName: map_reads {
                cpus        = 8
                memory      = '32 GB'
                time        = '4 h'
            }
            withName: plot_coverage {
                cpus        = 2
                memory      = '8 GB'
                time        = '1 h'
                queue       = 'short'
            }
            withName: call_variants {
                cpus        = 8
                memory      = '16 GB'
                time        = '4 h'
            }
            withName: filter_variants {
                cpus        = 2
                memory      = '4 GB'
                time        = '30 min'
                queue       = 'short'
            }
        }
    }

    // ----------------------------------------------------------
    // container — all processes run inside Docker or Singularity
    // Docker is tried first; Singularity is used on HPC where
    // Docker is unavailable (auto-detection via NXF_SINGULARITY_ENABLED)
    // ----------------------------------------------------------
    container {
        docker.enabled      = true
        singularity.enabled = false
        docker.runOptions   = '--platform linux/amd64'

        process {
            executor = 'local'   // override to 'slurm' for HPC + containers

            cpus    = 4
            memory  = '16 GB'
            time    = '4 h'

            withName: download_sra {
                container   = 'ghcr.io/ncbi/sra-tools:3.0.7'
                cpus        = 2
                memory      = '4 GB'
                time        = '30 min'
            }
            withName: run_qc {
                container   = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: trim_reads {
                container   = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: assemble_reads {
                container   = 'quay.io/biocontainers/spades:3.15.5--h95f258a_1'
                cpus        = 4
                memory      = '16 GB'
                time        = '2 h'
            }
            withName: map_reads {
                // Custom image: bwa + samtools bundled together
                container   = 'docker.io/youruser/bwa-samtools:1.0.0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: plot_coverage {
                // Custom image: R + ggplot2
                container   = 'docker.io/youruser/r-ggplot2:1.0.0'
                cpus        = 1
                memory      = '4 GB'
            }
            withName: call_variants {
                container   = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: filter_variants {
                container   = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
        }
    }

    // ----------------------------------------------------------
    // container_singularity — same images pulled as .sif on HPC
    // ----------------------------------------------------------
    container_singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false

        process {
            executor            = 'slurm'
            clusterOptions      = '--account=myproject'

            cpus    = 4
            memory  = '16 GB'
            time    = '4 h'

            withName: download_sra {
                container   = 'https://depot.galaxyproject.org/singularity/sra-tools:3.0.7--h9f5acd7_0'
                cpus        = 2
                memory      = '4 GB'
            }
            withName: run_qc {
                container   = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: trim_reads {
                container   = 'https://depot.galaxyproject.org/singularity/fastp:0.23.4--h5f740d0_0'
                cpus        = 2
                memory      = '2 GB'
            }
            withName: assemble_reads {
                container   = 'https://depot.galaxyproject.org/singularity/spades:3.15.5--h95f258a_1'
                cpus        = 4
                memory      = '16 GB'
                time        = '2 h'
            }
            withName: map_reads {
                container   = 'docker://youruser/bwa-samtools:1.0.0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: plot_coverage {
                container   = 'docker://youruser/r-ggplot2:1.0.0'
                cpus        = 1
                memory      = '4 GB'
            }
            withName: call_variants {
                container   = 'https://depot.galaxyproject.org/singularity/bcftools:1.18--h8b25389_0'
                cpus        = 4
                memory      = '8 GB'
            }
            withName: filter_variants {
                container   = 'https://depot.galaxyproject.org/singularity/bcftools:1.18--h8b25389_0'
                cpus        = 1
                memory      = '2 GB'
            }
        }
    }
}

// ------------------------------------------------------------
// REPORTING
// ------------------------------------------------------------
report {
    enabled  = true
    file     = "${params.outdir}/report.html"
    overwrite = true
}

timeline {
    enabled  = true
    file     = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/trace.txt"
    overwrite = true
}
