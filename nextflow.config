// Global configuration
params {
    input_reads_folder = ''
    sra_id = ''
    reference = ''
    assembly = false
    outdir = './results'
    threads = 2
}

// Disable conda
conda.enabled = false

// Process configuration
process {
    cpus = { params.threads }
    memory = { 8.GB }
    errorStrategy = "retry"
    maxRetries = 2
    
    withName: download_sra {
        cpus = 2
        memory = { 4.GB }
        time = { 30.minutes }
    }
    
    withName: run_qc {
        cpus = 2
        memory = { 2.GB }
    }
    
    withName: trim_reads {
        cpus = 2
        memory = { 2.GB }
    }
    
    withName: assemble_reads {
        cpus = 2
        memory = { 16.GB }
        time = { 2.hours }
    }
    
    withName: map_reads {
        cpus = 2
        memory = { 8.GB }
    }
    
    withName: plot_coverage {
        cpus = 1
        memory = { 4.GB }
    }
}

// Report configuration
report {
    enabled = true
    file = "${params.outdir}/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    overwrite = true
}